# Local development can leave this blank to use the same-origin Vercel API.
VITE_API_URL=

# Server-only secret. Never prefix this with VITE_ and never commit .env.
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
OPENROUTER_SITE_URL=https://your-outfitly-domain.vercel.app

# Optional local fallback provider; not needed for the hosted OpenRouter path.
OPENROUTER_VISION_MODEL=google/gemma-4-26b-a4b-it:free
